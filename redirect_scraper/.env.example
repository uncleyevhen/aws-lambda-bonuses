# Налаштування для входу в адмін-панель
# (використовуються з promo_service, тому можуть не потребувати окремого налаштування)
ADMIN_LOGIN=your_admin_login
ADMIN_PASSWORD=your_admin_password
ADMIN_URL=https://your-site.com/admin/

# AWS S3 налаштування (опціонально)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=eu-north-1

# Playwright налаштування
PLAYWRIGHT_HEADED=true   # false для headless режиму

# Додаткові налаштування
DEBUG_MODE=false
MAX_RETRIES=3
